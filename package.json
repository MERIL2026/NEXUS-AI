{
  "name": "@nexus-ai-nexoralabs/cli",
  "version": "0.1.3",
  "description": "NEXUS AI — Local-first AI workstation CLI. Think, plan, execute — powered by local AI runtime.",
  "main": "dist/cli/bin.js",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nexus": "dist/cli/bin.js"
  },
  "type": "module",
  "preferGlobal": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc && node -e \"fs.cpSync('src/ui/public', 'dist/ui/public', {recursive: true})\"",
    "start": "node dist/cli/bin.js",
    "dev": "tsx src/cli/bin.ts",
    "agent": "tsx src/cli/main.ts",
    "desktop:dev": "tsx src/desktop/main.ts",
    "desktop:build": "npm run build",
    "desktop:package": "electron-builder --dir",
    "desktop:installer": "electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:e2e:cli": "tsx scripts/verify_decomposition_cli_e2e.ts",
    "pack:audit": "npm pack --dry-run"
  },
  "keywords": [
    "nexus-ai",
    "local-ai",
    "ollama",
    "rag",
    "agents",
    "workstation",
    "cli"
  ],
  "author": "NEXUS AI Team",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.20.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
